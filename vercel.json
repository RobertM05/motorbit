{
  "regions": [
    "fra1"
  ],
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/car-sniper/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(brands|models/.*)",
      "headers": {
        "cache-control": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
      },
      "dest": "/backend/main.py"
    },
    {
      "src": "/api/(site/stats|deals/top)",
      "headers": {
        "cache-control": "public, max-age=120, s-maxage=300, stale-while-revalidate=600"
      },
      "dest": "/backend/main.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/backend/main.py"
    },
    {
      "src": "/initial-data\\.json",
      "headers": {
        "cache-control": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400"
      },
      "dest": "/frontend/car-sniper/initial-data.json"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/frontend/car-sniper/assets/$1"
    },
    {
      "src": "/(robots\\.txt|sitemap\\.xml|llms\\.txt)",
      "headers": {
        "cache-control": "public, max-age=86400"
      },
      "dest": "/frontend/car-sniper/$1"
    },
    {
      "src": "/(.*\\.(ico|png|jpg|jpeg|webp|svg|css|js|json|woff|woff2|ttf|eot|webmanifest))$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/frontend/car-sniper/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/car-sniper/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-scores",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/run",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 2 * * *"
    }
  ]
}
